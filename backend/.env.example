# Copy to .env and fill in
DATABASE_URL=postgresql+asyncpg://claw:claw@localhost:5432/claw_dev
JWT_SECRET=change-me-to-32-bytes-of-random
JWT_ALGORITHM=HS256
JWT_USER_TTL_HOURS=24
JWT_WORKER_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15
MAGIC_LINK_DELIVERY=console
APP_ENV=dev

# Optional ARC Testnet settlement. Leave disabled for off-chain-only bookings.
CHAIN_ENABLED=false
CHAIN_SIGNER_MODE=private_key
CHAIN_RPC_URL=https://rpc.testnet.arc.network
CHAIN_ID=5042002
CHAIN_ESCROW_ADDRESS=
CHAIN_USDC_ADDRESS=0x3600000000000000000000000000000000000000
CHAIN_SETTLER_KEY=
CHAIN_MAX_BOOKING_HOURS=8

# Use these instead of CHAIN_SETTLER_KEY when CHAIN_SIGNER_MODE=circle.
CIRCLE_API_BASE=https://api.circle.com/v1/w3s
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
